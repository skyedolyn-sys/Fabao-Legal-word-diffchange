{
  "version": "1.0.0",
  "description": "Risk assessment rules for contract revision analysis",
  "risk_levels": {
    "high": {
      "label": "强烈反对",
      "emoji": "🔴",
      "description": "对乙方有重大不利影响，必须要求修改"
    },
    "medium": {
      "label": "需协商",
      "emoji": "🟠",
      "description": "对乙方有一定影响，建议争取更有利条件"
    },
    "low": {
      "label": "可接受",
      "emoji": "🟢",
      "description": "对乙方影响较小或有利，可直接接受"
    }
  },
  "rules": [
    {
      "id": "rule_liability_001",
      "name": "取消责任上限",
      "applies_to_clause_types": [
        "违约责任"
      ],
      "applies_to_revision_types": [
        "deletion",
        "insertion"
      ],
      "patterns": {
        "deletion": [
          "不超过",
          "上限",
          "最高",
          "限额",
          "责任上限",
          "赔偿上限",
          "责任限制"
        ],
        "insertion": [
          "全部损失",
          "所有损失",
          "间接损失",
          "预期利益",
          "利润损失",
          "无上限",
          "无限额"
        ]
      },
      "risk_level": "high",
      "rationale": "取消责任上限或引入间接损失赔偿，显著扩大乙方赔偿责任范围"
    },
    {
      "id": "rule_liability_002",
      "name": "无过错责任",
      "applies_to_clause_types": [
        "违约责任"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "无论是否违约",
          "无论过错",
          "无过错",
          "严格责任",
          "绝对责任"
        ]
      },
      "risk_level": "high",
      "rationale": "引入无过错赔偿责任，乙方需为不可控因素承担责任"
    },
    {
      "id": "rule_ip_001",
      "name": "知识产权完全转让",
      "applies_to_clause_types": [
        "知识产权"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "归甲方所有",
          "转让给甲方",
          "甲方享有",
          "甲方拥有",
          "全部知识产权",
          "一切知识产权"
        ]
      },
      "risk_level": "high",
      "rationale": "将所有交付物知识产权完全转让给甲方，乙方丧失后续使用权"
    },
    {
      "id": "rule_ip_002",
      "name": "背景IP转让",
      "applies_to_clause_types": [
        "知识产权"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "背景知识产权",
          "背景IP",
          "已有知识产权",
          "现有技术",
          " pre-existing",
          "背景技术"
        ]
      },
      "risk_level": "high",
      "rationale": "要求转让乙方已有背景知识产权，超出合理范围"
    },
    {
      "id": "rule_data_001",
      "name": "承担所有第三方索赔",
      "applies_to_clause_types": [
        "数据安全"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "所有第三方索赔",
          "全部第三方索赔",
          "任何第三方索赔",
          "第三方的一切索赔",
          "承担.*第三方"
        ]
      },
      "risk_level": "high",
      "rationale": "要求乙方承担数据泄露导致的所有第三方索赔，责任不可控"
    },
    {
      "id": "rule_data_002",
      "name": "数据安全义务过重",
      "applies_to_clause_types": [
        "数据安全"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "等保三级",
          "等保3级",
          "ISO27001",
          "SOC2",
          "数据本地化",
          "境内存储",
          "不得出境"
        ]
      },
      "risk_level": "medium",
      "rationale": "引入超出行业标准的数据安全合规要求，增加运营成本"
    },
    {
      "id": "rule_service_001",
      "name": "开放式服务范围",
      "applies_to_clause_types": [
        "服务定义"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "包括但不限于",
          "所有相关",
          "所有合理",
          "任何需求",
          "一切需求",
          "满足甲方所有",
          "甲方提出的所有"
        ]
      },
      "risk_level": "medium",
      "rationale": "开放式表述导致服务范围不可量化，可能无限扩大乙方义务"
    },
    {
      "id": "rule_service_002",
      "name": "单方检查权",
      "applies_to_clause_types": [
        "服务定义"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "随时检查",
          "随时审计",
          "单方检查",
          "单方审计",
          "甲方有权检查",
          "甲方有权审计",
          "无通知检查"
        ]
      },
      "risk_level": "medium",
      "rationale": "赋予甲方无限制的检查/审计权，可能干扰乙方正常运营"
    },
    {
      "id": "rule_payment_001",
      "name": "付款账期延长",
      "applies_to_clause_types": [
        "费用与支付"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "90日",
          "90天",
          "120日",
          "120天",
          "6个月",
          "180天"
        ]
      },
      "risk_level": "medium",
      "rationale": "付款账期过长，影响乙方现金流"
    },
    {
      "id": "rule_payment_002",
      "name": "单方调价权",
      "applies_to_clause_types": [
        "费用与支付"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "甲方有权调整",
          "甲方可调整",
          "单方调整",
          "单方调价",
          "甲方决定价格"
        ]
      },
      "risk_level": "high",
      "rationale": "赋予甲方单方调价权，乙方收入不确定性大幅增加"
    },
    {
      "id": "rule_term_001",
      "name": "自动续约",
      "applies_to_clause_types": [
        "期限与终止"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "自动续期",
          "自动续约",
          "自动延长",
          "自动续签",
          "除非提前通知"
        ]
      },
      "risk_level": "medium",
      "rationale": "自动续约条款可能导致乙方被动陷入不利合同关系"
    },
    {
      "id": "rule_term_002",
      "name": "甲方单方终止权扩大",
      "applies_to_clause_types": [
        "期限与终止"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "甲方有权随时终止",
          "甲方有权单方终止",
          "甲方可随时解除",
          "无需理由终止",
          "任意解除"
        ]
      },
      "risk_level": "high",
      "rationale": "甲方可无理由单方终止，乙方投入无法回收"
    },
    {
      "id": "rule_term_003",
      "name": "竞业限制",
      "applies_to_clause_types": [
        "期限与终止"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "竞业禁止",
          "竞业限制",
          "不得与.*竞争",
          "不得为.*提供服务",
          "排他性"
        ]
      },
      "risk_level": "medium",
      "rationale": "竞业限制条款限制乙方与其他客户合作"
    },
    {
      "id": "rule_jurisdiction_001",
      "name": "甲方所在地管辖",
      "applies_to_clause_types": [
        "其他"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "甲方所在地",
          "甲方住所地",
          "甲方注册地",
          "原告所在地"
        ]
      },
      "risk_level": "medium",
      "rationale": "争议解决地点对乙方不利，增加诉讼成本"
    },
    {
      "id": "rule_service_003",
      "name": "免费义务",
      "applies_to_clause_types": [
        "服务定义",
        "费用与支付"
      ],
      "applies_to_revision_types": [
        "insertion"
      ],
      "patterns": {
        "insertion": [
          "免费提供",
          "无偿提供",
          "免费培训",
          "免费支持",
          "不另行收费"
        ]
      },
      "risk_level": "medium",
      "rationale": "要求乙方免费提供额外服务，增加成本"
    },
    {
      "id": "rule_template_001",
      "name": "无限赔偿责任（模板）",
      "applies_to_clause_types": [
        "违约责任"
      ],
      "applies_to_revision_types": [
        "existing"
      ],
      "applies_to_modes": [
        "template"
      ],
      "patterns": {
        "existing": [
          "无上限",
          "无限额",
          "全部损失",
          "所有损失",
          "间接损失",
          "利润损失",
          "预期利益"
        ]
      },
      "risk_level": "high",
      "rationale": "模板中存在无限赔偿责任条款，对乙方极为不利，建议增加责任上限"
    },
    {
      "id": "rule_template_002",
      "name": "单方任意解除权（模板）",
      "applies_to_clause_types": [
        "期限与终止"
      ],
      "applies_to_revision_types": [
        "existing"
      ],
      "applies_to_modes": [
        "template"
      ],
      "patterns": {
        "existing": [
          "有权随时终止",
          "有权单方终止",
          "可随时解除",
          "无需理由",
          "任意解除",
          "任意终止"
        ]
      },
      "risk_level": "high",
      "rationale": "甲方享有任意解除权而乙方无对等权利，权利义务严重失衡"
    },
    {
      "id": "rule_template_003",
      "name": "宽泛定义条款（模板）",
      "applies_to_clause_types": [
        "服务定义",
        "数据安全"
      ],
      "applies_to_revision_types": [
        "existing"
      ],
      "applies_to_modes": [
        "template"
      ],
      "patterns": {
        "existing": [
          "包括但不限于",
          "一切",
          "所有",
          "任何",
          "全部",
          "凡是由乙方",
          "凡与乙方有关"
        ]
      },
      "risk_level": "medium",
      "rationale": "模板中存在开放式定义条款，可能导致义务范围不可量化"
    },
    {
      "id": "rule_template_004",
      "name": "无责任上限保护（模板）",
      "applies_to_clause_types": [
        "违约责任"
      ],
      "applies_to_revision_types": [
        "existing"
      ],
      "applies_to_modes": [
        "template"
      ],
      "patterns": {
        "existing_regex": [
          "责任.*不.*限制",
          "赔偿.*不.*上限",
          "不设.*上限",
          "不设.*限额"
        ]
      },
      "risk_level": "high",
      "rationale": "违约责任条款中明确排除责任限制，乙方风险敞口无限"
    }
  ],
  "scoring": {
    "multiple_matches": "take_highest",
    "no_match_default": "low",
    "confidence_threshold": {
      "high": 0.8,
      "medium": 0.5,
      "low": 0.0
    }
  }
}