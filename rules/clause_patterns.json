{
  "version": "1.0.0",
  "description": "Clause type classification patterns. Match clause titles (headings) against keywords to determine clause type.",
  "priority_order": [
    "知识产权",
    "违约责任",
    "数据安全",
    "服务定义",
    "费用与支付",
    "期限与终止",
    "不可抗力",
    "其他"
  ],
  "patterns": {
    "知识产权": {
      "keywords": [
        "知识产权", "IP", "著作权", "版权", "专利", "商标", "技术成果",
        "成果归属", "知识产权归属", "专利权", "商标权", "商业秘密",
        "技术秘密", "know-how", "职务发明", "职务作品", "技术改进",
        "背景知识产权", "背景IP", "前景知识产权", "前景IP"
      ],
      "priority": 1
    },
    "违约责任": {
      "keywords": [
        "违约", "赔偿", "违约金", "责任限制", "责任上限", "免责",
        "罚金", "滞纳金", "间接损失", "直接损失", "全部损失",
        "连带责任", "保证", "担保", "质保", "质保期", "缺陷责任"
      ],
      "priority": 2
    },
    "数据安全": {
      "keywords": [
        "数据", "隐私", "保密", "信息安全", "网络安全", "个人信息",
        "个人数据", "数据安全", "数据保护", "GDPR", "等保", "PII",
        "泄露", "数据泄露", "数据出境", "跨境传输", "数据归属",
        "数据删除", "数据留存", "日志", "审计"
      ],
      "priority": 3
    },
    "服务定义": {
      "keywords": [
        "服务范围", "服务内容", "服务定义", "SOW", "工作说明书",
        "工作范围", "服务标准", "服务水平", "SLA", "验收", "交付",
        "交付物", "里程碑", "服务期限", "服务要求", "技术规格",
        "功能需求", "性能指标", "可用性", "排他性", "独家"
      ],
      "priority": 4
    },
    "费用与支付": {
      "keywords": [
        "费用", "价格", "价款", "付款", "支付", "发票", "账期",
        "预付款", "定金", "保证金", "尾款", "结算", "调价",
        "涨价", "降价", "折扣", "优惠", "费率", "单价", "总价",
        "预算", "成本", "差旅费", "人工费"
      ],
      "priority": 5
    },
    "期限与终止": {
      "keywords": [
        "期限", "有效期", "合同期限", "服务期限", "起止日期",
        "续约", "续签", "展期", "延长", "终止", "解除", "退出",
        "暂停", "中止", "提前终止", "单方解除", "通知期",
        "过渡期", "竞业", "竞业禁止", "排他期"
      ],
      "priority": 6
    },
    "不可抗力": {
      "keywords": [
        "不可抗力", "force majeure", "天灾", "疫情", "政府行为",
        "战争", "罢工", "自然灾害", "不可预见", "不能避免"
      ],
      "priority": 7
    },
    "其他": {
      "keywords": [
        "争议解决", "管辖", "仲裁", "诉讼", "法律适用", "适用法律",
        "通知", "送达", "完整协议", "修改", "变更", "转让",
        "分包", "转包", "第三方", "代表", "授权", "签字",
        "盖章", "生效", "附件", "补充协议", "语言", "副本"
      ],
      "priority": 8
    }
  },
  "matching": {
    "strategy": "longest_match_first",
    "case_sensitive": false,
    "match_whole_word": false,
    "fallback_type": "其他"
  }
}
